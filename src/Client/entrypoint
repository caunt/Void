#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
display_number="${DISPLAY#:}"
display_number="${display_number%%.*}"

rm -f "/tmp/.X$display_number-lock"

Xvfb "$DISPLAY" -screen 0 854x480x24 -noreset -nolisten tcp &
display_process_id=$!

until xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; do
  if ! kill -0 "$display_process_id" 2>/dev/null; then
    wait "$display_process_id"
  fi

  sleep 0.1
done

matchbox-window-manager -use_titlebar no -use_cursor no &
x11vnc -ncache_cr -display "$DISPLAY" -nopw -forever -shared -rfbport 5900 -pointer_mode 1 -noxfixes -cursor arrow &
websockify --web=/usr/share/novnc 80 127.0.0.1:5900 &

exec dotnet run Api.cs "$@"
