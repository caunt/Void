#!/usr/bin/env bash
set -euo pipefail

minecraft_directory="${MINECRAFT_DIRECTORY:-/root/.minecraft}"
portablemc_version="${PORTABLEMC_DEMO_VERSION:-neoforge:release:unstable}"
version_marker="$minecraft_directory/.portablemc-demo-version"
portablemc_arguments=()

if [[ "$(uname -m)" == "aarch64" ]]; then
  portablemc_arguments+=(--fix-lwjgl 3.4.1 --exclude-lib 'org.lwjgl:lwjgl-vulkan:*:natives-linux-arm64')
fi

prepare_demo() {
  mkdir -p "$minecraft_directory/config" "$minecraft_directory/mods"
  cp /opt/portableminecraftclient/demo/options.txt "$minecraft_directory/options.txt"
  cp /opt/portableminecraftclient/demo/sodium-options.json "$minecraft_directory/config/sodium-options.json"
  printf '%s' '0a0000090007736572766572730a0000000101000668696464656e000800026970000a766f69643a32353536350800046e616d65000a566f69642050726f78790000' | xxd -r -p > "$minecraft_directory/servers.dat"

  portablemc-dry-run-with-retries "$portablemc_version" --demo --main-dir "$minecraft_directory" "${portablemc_arguments[@]}"

  minecraft_version="$(jq -r 'select(.downloads.client).id' "$minecraft_directory"/versions/*/*.json | tail -n 1)"
  loader="${portablemc_version%%:*}"
  sodium_url=""

  rm -f "$minecraft_directory/mods/sodium.jar"
  if sodium_versions="$(curl --fail --silent --show-error --location --retry 3 --user-agent caunt/Void --get \
      --data-urlencode "loaders=[\"$loader\"]" \
      --data-urlencode "game_versions=[\"$minecraft_version\"]" \
      https://api.modrinth.com/v2/project/AANobbMI/version)"; then
    sodium_url="$(jq -r 'first(.[].files[]? | select(.primary == true).url) // empty' <<< "$sodium_versions" 2>/dev/null || true)"
  fi

  if [[ -n "$sodium_url" ]]; then
    temporary_sodium="$(mktemp "$minecraft_directory/mods/.sodium.jar.XXXXXX")"
    if curl --fail --silent --show-error --location --retry 3 --user-agent caunt/Void --output "$temporary_sodium" "$sodium_url"; then
      mv "$temporary_sodium" "$minecraft_directory/mods/sodium.jar"
    else
      rm -f "$temporary_sodium"
      echo "Warning: Sodium download failed for $loader Minecraft $minecraft_version" >&2
    fi
  else
    echo "Warning: Sodium was not found for $loader Minecraft $minecraft_version" >&2
  fi

  printf '%s' "$portablemc_version" > "$version_marker"
}

if [[ ! -f "$version_marker" || "$(< "$version_marker")" != "$portablemc_version" ]]; then
  prepare_demo
fi

if [[ "${1:-}" == "--prepare" ]]; then
  exit 0
fi

export DISPLAY="${DISPLAY:-:0}"
rm -f /tmp/.X0-lock

Xvfb "$DISPLAY" -screen 0 1280x720x24 &
sleep 1
matchbox-window-manager -use_titlebar no -use_cursor no &
sleep 1
wish /opt/portableminecraftclient/demo/splash.tcl &
x11vnc -ncache_cr -display "$DISPLAY" -nopw -forever -shared -rfbport 5900 -bg -pointer_mode 1 -noxfixes -cursor arrow
sleep 1
websockify --web=/usr/share/novnc 80 127.0.0.1:5900 &

read -r -a requested_portablemc_arguments <<< "${PORTABLEMC_ARGUMENTS:-}"
exec portablemc start "$portablemc_version" --demo --main-dir "$minecraft_directory" --jvm-arg=-Djava.awt.headless=false "${portablemc_arguments[@]}" "${requested_portablemc_arguments[@]}"
