#!/usr/bin/env bash

set -euo pipefail

: "${TARGET:?TARGET is required}"
: "${MINECRAFT_VERSIONS:?MINECRAFT_VERSIONS is required}"
: "${PLATFORM:?PLATFORM is required}"
: "${ARCHITECTURE:?ARCHITECTURE is required}"
: "${IMAGE_REPOSITORY:?IMAGE_REPOSITORY is required}"
: "${CACHE_REPOSITORY:?CACHE_REPOSITORY is required}"
: "${DIGESTS_FILE:?DIGESTS_FILE is required}"

MAX_ATTEMPTS="${MAX_ATTEMPTS:-5}"
RETRY_DELAY_SECONDS="${RETRY_DELAY_SECONDS:-10}"
CLIENT_CONTEXT="${CLIENT_CONTEXT:-src/Client}"

if [ "$PLATFORM" != "linux/$ARCHITECTURE" ]; then
  echo "Platform $PLATFORM does not match architecture $ARCHITECTURE."
  exit 1
fi

case "$TARGET" in
  latest|offline)
    jq -e 'type == "array" and length == 0' <<< "$MINECRAFT_VERSIONS" > /dev/null
    ;;
  version)
    jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' <<< "$MINECRAFT_VERSIONS" > /dev/null
    ;;
  *)
    echo "Unsupported client image target: $TARGET"
    exit 1
    ;;
esac

if ! [[ "$MAX_ATTEMPTS" =~ ^[1-9][0-9]*$ ]]; then
  echo "MAX_ATTEMPTS must be a positive integer."
  exit 1
fi

if ! [[ "$RETRY_DELAY_SECONDS" =~ ^[0-9]+$ ]]; then
  echo "RETRY_DELAY_SECONDS must be a non-negative integer."
  exit 1
fi

mkdir -p "$(dirname "$DIGESTS_FILE")"
digest_map='{}'

build_and_push_digest() {
  local target="$1"
  local final_image="$2"
  local minecraft_version="${3:-}"
  local metadata_file
  local digest
  local attempt
  local safe_image_name
  local docker_build_command=(
    docker buildx build
    --platform "$PLATFORM"
    --target "$target"
    --output "type=image,name=$IMAGE_REPOSITORY,push-by-digest=true,name-canonical=true,push=true"
    --provenance mode=min
    --cache-from "type=registry,ref=$CACHE_REPOSITORY:runtime-$ARCHITECTURE"
    --cache-from "type=registry,ref=$CACHE_REPOSITORY:runtime"
    --cache-from "type=registry,ref=$final_image"
    --cache-to type=inline
  )

  safe_image_name=$(tr '/:' '__' <<< "$final_image")
  metadata_file="${RUNNER_TEMP:-/tmp}/client-build-$ARCHITECTURE-$safe_image_name.json"

  case "$target" in
    latest)
      docker_build_command+=(--cache-to "type=registry,ref=$CACHE_REPOSITORY:runtime-$ARCHITECTURE,mode=max,ignore-error=true")
      ;;
    offline)
      docker_build_command+=(
        --cache-from "type=registry,ref=$CACHE_REPOSITORY:offline-$ARCHITECTURE"
        --cache-from "type=registry,ref=$CACHE_REPOSITORY:offline"
        --cache-to "type=registry,ref=$CACHE_REPOSITORY:offline-$ARCHITECTURE,mode=max,ignore-error=true"
      )
      ;;
    version)
      docker_build_command+=(--build-arg "MINECRAFT_VERSION=$minecraft_version")
      ;;
  esac

  docker_build_command+=(--metadata-file "$metadata_file" "$CLIENT_CONTEXT")

  for (( attempt = 1; attempt <= MAX_ATTEMPTS; attempt++ )); do
    unlink "$metadata_file" 2>/dev/null || true

    if "${docker_build_command[@]}"; then
      digest=$(jq -er '."containerimage.digest" | select(test("^sha256:[0-9a-f]{64}$"))' "$metadata_file")
      digest_map=$(jq -c --arg image "$final_image" --arg digest "$digest" '. + {($image): $digest}' <<< "$digest_map")
      return 0
    fi

    if (( attempt == MAX_ATTEMPTS )); then
      echo "Failed to build $final_image for $PLATFORM after $MAX_ATTEMPTS attempts."
      return 1
    fi

    echo "Attempt $attempt failed for $final_image on $PLATFORM. Retrying in $(( RETRY_DELAY_SECONDS * attempt )) seconds."
    sleep $(( RETRY_DELAY_SECONDS * attempt ))
  done
}

if [ "$TARGET" = version ]; then
  while IFS= read -r minecraft_version; do
    build_and_push_digest version "$IMAGE_REPOSITORY:$minecraft_version" "$minecraft_version"
  done < <(jq -r '.[]' <<< "$MINECRAFT_VERSIONS")
else
  build_and_push_digest "$TARGET" "$IMAGE_REPOSITORY:$TARGET"
fi

printf '%s\n' "$digest_map" > "$DIGESTS_FILE"

if [ -n "${GITHUB_OUTPUT:-}" ]; then
  printf 'digests=%s\n' "$digest_map" >> "$GITHUB_OUTPUT"
fi
