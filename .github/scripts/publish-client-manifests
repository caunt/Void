#!/usr/bin/env bash

set -euo pipefail

: "${AMD64_DIGESTS:?AMD64_DIGESTS is required}"
: "${ARM64_DIGESTS:?ARM64_DIGESTS is required}"
: "${IMAGE_REPOSITORY:?IMAGE_REPOSITORY is required}"

jq -e 'type == "object" and length > 0 and all(.[]; type == "string" and test("^sha256:[0-9a-f]{64}$"))' <<< "$AMD64_DIGESTS" > /dev/null
jq -e 'type == "object" and length > 0 and all(.[]; type == "string" and test("^sha256:[0-9a-f]{64}$"))' <<< "$ARM64_DIGESTS" > /dev/null

if ! jq -e -n --argjson amd64 "$AMD64_DIGESTS" --argjson arm64 "$ARM64_DIGESTS" '($amd64 | keys) == ($arm64 | keys)' > /dev/null; then
  echo "Architecture builds produced different client image tag sets."
  exit 1
fi

while IFS= read -r image; do
  if [[ "$image" != "$IMAGE_REPOSITORY:"* ]]; then
    echo "Unexpected client image name: $image"
    exit 1
  fi

  amd64_digest=$(jq -er --arg image "$image" '.[$image]' <<< "$AMD64_DIGESTS")
  arm64_digest=$(jq -er --arg image "$image" '.[$image]' <<< "$ARM64_DIGESTS")

  docker buildx imagetools create \
    --tag "$image" \
    "$IMAGE_REPOSITORY@$amd64_digest" \
    "$IMAGE_REPOSITORY@$arm64_digest"

  manifest=$(docker buildx imagetools inspect "$image" --raw)

  jq -e '
    ([.manifests[] | select(.platform.os == "linux") | .platform.architecture] | sort) == ["amd64", "arm64"]
    and ([.manifests[] | select(.annotations["vnd.docker.reference.type"] == "attestation-manifest")] | length) == 2
  ' <<< "$manifest" > /dev/null

  echo "Published verified client manifest $image"
done < <(jq -r 'keys[]' <<< "$AMD64_DIGESTS")
